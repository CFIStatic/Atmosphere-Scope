# Optional. Transcription and object identification. Measurement does not use this key.
# OpenAI Whisper is about $0.006 per minute. gpt-4o-mini vision is about $0.01 per keyframe.
OPENAI_API_KEY=

# Optional. Replacement prices from Google Shopping via SerpAPI, about $0.01–$0.02 per item.
# Leave blank and prices stay blank. The app does not invent a price.
SERPAPI_API_KEY=
