# Required for transcription, object identification, and replacement prices.
# Room measurement and local storage do not use this key.
# Speech-to-text default: gpt-4o-mini-transcribe (a few tenths of a cent per minute).
# Set OPENAI_TRANSCRIBE_MODEL=whisper-1 for the older model, about $0.006 per minute.
# ANALYSIS_MODE=cascade (default) triages every frame on gpt-4o-mini, then confirms
# uncertain or narrated damage on gpt-6-astra using object crops.
# Planning estimates at ~12 distinct frames, not invoices:
#   cascade about $0.28/min, strong about $1.54/min, cheap about $0.02/min, plus $0.003 transcription.
# strong sends every frame and tile to OPENAI_VISION_MODEL. cheap never calls it.
# ANALYSIS_ESCALATE_BELOW=0.75 sends low-confidence objects to the strong model.
# ANALYSIS_AUDIT_RATE=0.1 also sends a random 10% of confident-ok objects.
# Keyframe notes stay on gpt-4o-mini.
# ANALYSIS_LEASE_MS is optional (default 120000). ANALYSIS_POLL_MS is optional (default 4000).
# Replacement prices: Responses API web search, then a server-side check of the product page.
# Web search is billed per search and is often cents per item. Unverified prices stay marked.
OPENAI_API_KEY=

# Optional model overrides.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRIAGE_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-6-astra
# ANALYSIS_MODE=cascade
# ANALYSIS_ESCALATE_BELOW=0.75
# ANALYSIS_AUDIT_RATE=0.1
# OPENAI_PRICING_MODEL=gpt-4o-mini
# OPENAI_WEB_SEARCH_TOOL=web_search

# Optional shopping adapter. Ignored unless PRICING_PROVIDER=serpapi.
# A SerpAPI key by itself does not replace OpenAI web search.
# PRICING_PROVIDER=openai
# SERPAPI_API_KEY=

# Optional GPU measurement adapters. Unset means local OpenCV on this server.
# This build still measures with OpenCV even when a GPU adapter is named.
# It does not call Replicate or Modal, and it does not invent a model endpoint.
# MEASUREMENT_BACKEND=local
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Optional storage. Unset or local uses data/ on disk. No extra key.
# See docs/STORAGE.md before setting supabase.
# STORAGE=local
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# Sign-in uses the anon key on the server. It is not a NEXT_PUBLIC_ variable.
# Hosted auth is on only when STORAGE=supabase. See docs/AUTH.md.
# Role is app_metadata.role: admin, estimator, or customer. user_metadata.role is ignored.
# SITE_URL is the public origin used in reset and invite links.
# The dev-only cookie is signed. Set SESSION_SECRET if you want that signature to survive a restart.
# SUPABASE_ANON_KEY=
# SITE_URL=
# SESSION_SECRET=

# Server-side price verification. These are not NEXT_PUBLIC_ variables.
# Lookups are cached by normalized item name. 21600 seconds is 6 hours.
# PRICE_CACHE_TTL_SECONDS=21600
# PRICE_FETCH_MIN_INTERVAL_MS=1000
# PRICE_FETCH_TIMEOUT_MS=8000
# PRICE_FETCH_MAX_BYTES=500000

# Persistent directory for jobs, media, and in-progress capture uploads.
# Railway: mount a volume at /data and set DATA_DIR=/data.
# DATA_DIR=
# ANALYSIS_LEASE_MS=120000
# ANALYSIS_POLL_MS=4000
